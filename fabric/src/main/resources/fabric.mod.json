{
	"schemaVersion": 1,
	"id": "${mod_id}",
	"version": "${version}",
	"name": "${mod_name}",
	"description": "${mod_description}",
	"authors": [
		"${mod_author}"
	],
	"contact": {
		"homepage": "${mod_homepage}",
		"sources": "${mod_sources}",
		"issues": "${mod_issues}"
	},
	"license": "${mod_license}",
	"icon": "assets/${mod_id}/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"cc.avie.tabbylib.fabric.TabbyLibFabric"
		],
		"modmenu": [
			"cc.avie.tabbylib.compat.ModMenuCompat"
		]
	},
	"mixins": [
		"${mod_id}.mixins.json"
	],
	"depends": {
		"fabric-api": "*",
		"fabricloader": ">=${fabric_loader_version}",
		"minecraft": "~${minecraft_version}",
		"java": ">=${java_version}"
	},
	"custom": {
		"modmenu": {
			"badges": [
				"library"
			],
			"links": {
				"avie.discord": "https://discord.gg/57TZ8BJvd9"
			}
		}
	}
}
